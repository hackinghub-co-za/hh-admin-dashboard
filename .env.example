# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PayFast credentials are server-side only now - set via:
#   supabase secrets set PAYFAST_MERCHANT_ID=...
#   supabase secrets set PAYFAST_MERCHANT_KEY=...
#   supabase secrets set PAYFAST_PASSPHRASE=...
# Never add these here with a VITE_ prefix - that bundles them into the
# browser JS for anyone to read.
